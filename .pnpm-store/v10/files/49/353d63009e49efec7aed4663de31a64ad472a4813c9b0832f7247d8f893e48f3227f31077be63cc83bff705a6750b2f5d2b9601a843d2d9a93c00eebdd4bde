/**
 * Filters out NEXT plugins that have `apply: 'serve'` set.
 *
 * Since Rolldown operates in build mode, plugins marked with `apply: 'serve'`
 * are intended only for NEXT's dev server and should be excluded from the build process.
 *
 * @param plugins - Array of plugins (can include nested arrays)
 * @returns Filtered array with serve-only plugins removed
 *
 * @example
 * ```ts
 * import { defineConfig } from 'rolldown';
 * import { filterNEXTPlugins } from '@rolldown/pluginutils';
 * import NEXTReact from '@NEXTjs/plugin-react';
 *
 * export default defineConfig({
 *   plugins: filterNEXTPlugins([
 *     NEXTReact(),
 *     {
 *       name: 'dev-only',
 *       apply: 'serve', // This will be filtered out
 *       // ...
 *     }
 *   ])
 * });
 * ```
 */
export declare function filterNEXTPlugins<T = any>(plugins: T | T[] | null | undefined | false): T[];

{
  "name": "prompt-app",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "update": "(pnpm outdated || [ $? -eq 1 ]) && pnpm dlx npm-check-updates -u && pnpm install",
    "preview": "vite preview",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "setup:cloud-env": "bash scripts/setup-cloud-env.sh",
    "clean": "pnpm clean:build && pnpm clean:cache && pnpm clean:reports",
    "clean:build": "rm -rf dist",
    "clean:cache": "rm -rf node_modules/.cache node_modules/.vite .eslintcache pnpm-lock.yaml",
    "clean:reports": "rm -rf coverage playwright-report test-results",
    "clean:modules": "rm -rf node_modules",
    "clean:reset": "pnpm clean && pnpm clean:modules && pnpm store prune && pnpm install",
    "postinstall": "playwright install"
  },
  "cspell": {
    "words": [
      "update",
      "outdated",
      "pnpm",
      "vite",
      "tsconfig",
      "noEmit",
      "drizzle",
      "netlify",
      "jsdom",
      "esbenp",
      "neon",
      "supabase",
      "dexie",
      "lucide",
      "sentry",
      "rollup",
      "visualizer",
      "axe",
      "playwright",
      "jest",
      "eslint",
      "typescript"
    ]
  },
  "pnpm": {
    "overrides": {
      "underscore": ">=1.13.8",
      "underscore.string": ">=3.3.5",
      "uuid": ">=13.0.1",
      "esbuild": ">=0.25.0"
    }
  },
  "dependencies": {
    "@netlify/neon": "^0.1.2",
    "@netlify/vite-plugin": "^2.12.8",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.3.1",
    "@sentry/browser": "^10.62.0",
    "@sentry/react": "^10.62.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "workflow": "^4.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "netlify-cli": "^26.1.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "supabase": "^2.108.0",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.0"
  }
}

{
  "name": "prompt-app",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@10.33.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "netlify dev:exec drizzle-kit migrate",
    "db:studio": "netlify dev:exec drizzle-kit studio",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "setup:cloud-env": "bash scripts/setup-cloud-env.sh",
    "clean": "pnpm clean:build && pnpm clean:cache && pnpm clean:reports",
    "clean:build": "rm -rf dist",
    "clean:cache": "rm -rf node_modules/.cache node_modules/.vite .eslintcache pnpm-lock.yaml",
    "clean:reports": "rm -rf coverage playwright-report test-results",
    "clean:modules": "rm -rf node_modules",
    "clean:reset": "pnpm clean && pnpm clean:modules && pnpm store prune && pnpm install"
  },
  "pnpm": {
    "overrides": {
      "underscore": ">=1.13.8",
      "underscore.string": ">=3.3.5",
      "uuid": ">=13.0.1",
      "esbuild": ">=0.25.0"
    }
  },
  "dependencies": {
    "23": "^0.0.0",
    "@netlify/neon": "^0.1.2",
    "@netlify/vite-plugin": "^2.12.1",
    "@sentry/browser": "^10.51.0",
    "@sentry/react": "^10.51.0",
    "@sentry/vite-plugin": "^5.2.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "fix": "^0.0.6",
    "netlify-cli": "^26.0.1",
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10"
  }
}
